<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} [job_id=%X{job_id:--} partition_id=%X{partition_id:--}] - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${ESS_LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
